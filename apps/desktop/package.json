{
  "name": "@moonlet/desktop",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.1.33",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "prepare:bins": "node scripts/prepare-bins.mjs",
    "bundle": "tauri build --config src-tauri/tauri.bundle.json",
    "build:ds": "vite build --config vite.ds.config.ts && tsc -p tsconfig.ds.json",
    "e2e:build": "../../scripts/clean-env.sh node scripts/e2e-build.mjs",
    "e2e": "../../scripts/clean-env.sh wdio run e2e/wdio.conf.ts",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.50.0",
    "markdown-it": "^15.0.2",
    "material-icon-theme": "5.39.0",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^4.0.0",
    "webdriverio": "^9.32.0"
  }
}
