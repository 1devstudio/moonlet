<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon's login item (X56). The app registers it with SMAppService;
     macOS lists it under Login Items as moonlet. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.onedevstudio.moonlet.moonletd</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/moonletd</string>
  <key>ProgramArguments</key>
  <array>
    <string>moonletd</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>dev.onedevstudio.moonlet</string>
  </array>
</dict>
</plist>
