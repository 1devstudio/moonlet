{
  "name": "moonlet",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @moonlet/desktop tauri dev",
    "build": "pnpm --filter @moonlet/desktop tauri build",
    "test": "cargo test --workspace && pnpm --filter @moonlet/desktop --filter @moonlet/mobile test",
    "e2e:build": "pnpm --filter @moonlet/desktop e2e:build",
    "e2e": "pnpm --filter @moonlet/desktop e2e",
    "mobile": "pnpm --filter @moonlet/mobile tauri dev",
    "mobile:ios": "pnpm --filter @moonlet/mobile tauri ios dev"
  },
  "packageManager": "pnpm@11.20.0"
}
