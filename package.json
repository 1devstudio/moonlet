{
  "name": "moonlet",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @moonlet/desktop tauri dev",
    "build": "pnpm --filter @moonlet/desktop tauri build",
    "test": "scripts/clean-env.sh --scratch-home sh -c 'cargo test --workspace && pnpm --filter @moonlet/desktop --filter @moonlet/mobile test'",
    "check": "pnpm --filter @moonlet/desktop typecheck && pnpm --filter @moonlet/desktop e2e:typecheck && pnpm test",
    "e2e:build": "pnpm --filter @moonlet/desktop e2e:build",
    "e2e": "pnpm --filter @moonlet/desktop e2e",
    "mobile": "pnpm --filter @moonlet/mobile tauri dev",
    "mobile:ios": "pnpm --filter @moonlet/mobile tauri ios dev"
  },
  "packageManager": "pnpm@11.20.0"
}
